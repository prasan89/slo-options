# mock | upstox
DATA_PROVIDER=mock

# Upstox read-only market-data mode
# Never commit a real token.
UPSTOX_ACCESS_TOKEN=

# JSON map of SLO symbols to Upstox underlying instrument keys.
# Example:
SLO_UNDERLYING_KEYS={"NIFTY":"NSE_INDEX|Nifty 50","BANKNIFTY":"NSE_INDEX|Nifty Bank"}

# JSON map used by paper position sizing. Configure actual current lot sizes.
SLO_LOT_SIZES={"NIFTY":1,"BANKNIFTY":1}
