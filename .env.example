# mock | upstox | groww
DATA_PROVIDER=mock

# Upstox read-only market-data mode
# Never commit a real token.
UPSTOX_ACCESS_TOKEN=

# Groww read-only market-data mode
# Never commit a real token.
GROWW_ACCESS_TOKEN=

# JSON map of SLO symbols to Upstox underlying instrument keys.
SLO_UNDERLYING_KEYS={"NIFTY":"NSE_INDEX|Nifty 50","BANKNIFTY":"NSE_INDEX|Nifty Bank"}

# JSON map of SLO symbols to Groww underlying trading symbols.
SLO_GROWW_UNDERLYING_SYMBOLS={"NIFTY":"NIFTY","BANKNIFTY":"BANKNIFTY"}

# JSON map used by paper position sizing. Configure actual current lot sizes.
SLO_LOT_SIZES={"NIFTY":1,"BANKNIFTY":1}

# Paper account configuration
SLO_PAPER_CAPITAL=1500000
SLO_PAPER_TRADE_ALLOCATION=150000
SLO_PAPER_INTERVAL_SECONDS=300
